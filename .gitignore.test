# 测试相关的 Git 忽略文件

# Jest 覆盖率报告
coverage/
*.lcov

# Playwright 测试结果
playwright-report/
test-results/

# Jest 缓存
.jest-cache/

# 测试生成的临时文件
*.test.js.snap
*.test.tsx.snap

# E2E 测试截图
tests/e2e/**/*.png
!tests/e2e/**/baseline/*.png

# E2E 测试视频
tests/e2e/**/*.webm
tests/e2e/**/*.mp4

# Playwright 浏览器缓存
.cache/ms-playwright/
